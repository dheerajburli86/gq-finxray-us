+TARGET_STEP = 10       # Increased from 5 for bigger jumps
+MAX_TARGET = 180       # Increased from 100 for longer articles
 
 # Absolute floor. Below this a "summary" is a fragment, whatever the source.
 ABS_MIN_WORDS = 12
